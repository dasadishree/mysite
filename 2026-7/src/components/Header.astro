---
const {title, description} = Astro.props;
import auraImage from "../assets/backgrounds/aura.jpg";
import meImage from "../assets/me/me.jpg";
import "./Header.css";
---
<html>
    <head>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Pinyon+Script&display=swap" rel="stylesheet">
        <title>adishree das</title>
    </head>

    <body>
        <header class="hero" id="main-content">
            <div class="auraImg">
                <img src={auraImage.src} alt="aura background"/>
            </div>
            <div class="container">
                <div class="meSection">
                    <div class="photo-caption">
                        <span>*website semi-under construction / not fully updated!!!!!*</span>
                        <svg class="curved-arrow" width="50" height="50" viewBox="0 0 50 50" fill="none">
                            <path d="m40 10C35 15 25 15 15 35M15 35L12 25M15 35L25 32" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <img src={meImage.src} alt="an image of me (adishree)!!" class="mePhoto" id="main-photo">
                </div>

                <div class="text">
                    <h1>welcome to</h1>
                    <p class="subtitle">adishree's internet corner</p>
                </div>

                <div class="nav-links">
                    <a href="#about" class="nav-btn btn-1">about me</a>
                    <a href="#experiences" class="nav-btn btn-3">experiences</a>
                </div>
                <div class="social-links">
                    <a href="https://drive.google.com/file/d/1cLCS8aWujnOLg9msk3I81-qkPabN4tgA/view?usp=sharing" target="_blank" rel="noopener noreferrer" class="social-link social-link-text" aria-label="Resume">
                        <span>CV</span>
                    </a>
                    <a href="https://github.com/dasadishree" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                            <path d="M15 22V18C15.1392 16.7473 14.78 15.4901 14 14.5C17 14.5 20 12.5 20 9C20.08 7.75 19.73 6.52 19 5.5C19.28 4.35 19.28 3.15 19 2C19 2 18 1.5 16 3C14.62 2.65 13.13 2.65 11.75 3C10.75 1.5 9.75 2 9.75 2C9.47 3.15 9.47 4.35 9.75 5.5C9.02 6.52 8.67 7.75 8.75 9C8.75 12.5 11.75 14.5 14.75 14.5C14 15.5 13.64 16.75 13.75 18V22" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M9 18C4 19.5 4 16.5 2 16" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    <a href="https://www.linkedin.com/in/dasadishree" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="LinkedIn">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="white" xmlns="http://www.w3.org/2000/svg">
                            <path d="M16 8C17.5913 8 19.1174 8.63214 20.2426 9.75736C21.3679 10.8826 22 12.4087 22 14V21H18V14C18 13.4696 17.7893 12.9609 17.4142 12.5858C17.0391 12.2107 16.5304 12 16 12C15.4696 12 14.9609 12.2107 14.5858 12.5858C14.2107 12.9609 14 13.4696 14 14V21H10V14C10 12.4087 10.6321 10.8826 11.7574 9.75736C12.8826 8.63214 14.4087 8 16 8Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M6 9H2V21H6V9Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M4 6C5.10457 6 6 5.10457 6 4C6 2.89543 5.10457 2 4 2C2.89543 2 2 2.89543 2 4C2 5.10457 2.89543 6 4 6Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    <a href="mailto:dasadishree@gmail.com" class="social-link" aria-label="Email">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M22 6L12 13L2 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M2 6L12 13L22 6" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                </div>

            </div>
        </header>
    </body>
</html>
